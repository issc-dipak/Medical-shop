# MongoDB connection string.
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/medledger
# Or MongoDB Atlas (replace with your own cluster URL):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medledger

# Port the API server runs on
PORT=5000

# Secret used to sign JWT auth tokens — change this to a long random string
JWT_SECRET=change_this_to_a_long_random_secret

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_ORIGIN=http://localhost:3000
